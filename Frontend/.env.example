# Aegis Sentinel AI Command Center - Environment Configuration
# Copy this file to .env or .env.local for local configuration.
# DO NOT commit real secrets or credentials to version control.

# API Gateway & Backend Services
VITE_AEGIS_API_BASE_URL=https://api.aegisguard.io/v1
VITE_AEGIS_GATEWAY_VERSION=v1.4

# SOC Operational Environment (production, staging, sandbox)
VITE_AEGIS_ENVIRONMENT=production

# Security & Feature Enclaves
VITE_ENABLE_MULTI_TENANT_ISOLATION=true
VITE_ENABLE_AST_PROMPT_INSPECTOR=true
VITE_ENABLE_EMERGENCY_LOCKDOWN=true
