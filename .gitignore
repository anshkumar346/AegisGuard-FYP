# ==============================================================================
# Aegis Guard FYP - Git Ignore Rules
# ==============================================================================

# Node Dependencies
node_modules/
Frontend/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
Frontend/dist/
build/
Frontend/build/
dist-ssr/
*.local

# Environment Variables & Secrets (Prevent accidental leaks)
.env
.env.*
!.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example
*.pem
*.key
*.cert
*.pfx

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# Log & Debug Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches & Local Artifacts
.vite/
Frontend/.vite/
.cache/
.npm/
.eslintcache
*.tmp
*.bak
*.png
